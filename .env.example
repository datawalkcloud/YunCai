# 复制为 .env 后填写真实值。`.env` 已被 .gitignore 排除，切勿提交。
# 生成随机密钥：openssl rand -base64 48 | tr -d '/+='

# Development / Staging / Production
YUNCAI_ENVIRONMENT=Production

# 数据库（compose 内置的 postgres 服务）
YUNCAI_DB_NAME=yuncai
YUNCAI_DB_USER=yuncai
YUNCAI_DB_PASSWORD=
YUNCAI_JWT_KEY=

# 对外访问地址与端口
YUNCAI_PUBLIC_ORIGIN=http://localhost
YUNCAI_HTTP_PORT=80

# 配好 TLS 证书后再打开（否则会强制跳转导致访问不了）
YUNCAI_HTTPS_REDIRECT=false
YUNCAI_USE_HSTS=false

YUNCAI_IMAGE_TAG=1.1.0

# 官网入口：默认 false，不展示「云财」品牌标识与「返回官网」入口（适合私有化/二次分发）。
# 如需展示官方官网入口，设为 true；容器启动时生成前端配置，改这里后重启 web 容器即可生效，
# 无需重新构建镜像。
YUNCAI_SHOW_OFFICIAL_SITE=false

# 官网联系表单：企业微信群机器人 webhook 完整地址（含 key，属机密）。
# 留空则官网留言入口显示「暂未开放」，接口直接返回 503；填入后留言会推送到该群。
# 在群设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址获取。切勿把真实值提交到仓库。
YUNCAI_CONTACT_WEBHOOK=

# 从 ACR 拉取 CI 构建的镜像时使用（docker-compose.acr.yml）
ACR_REGISTRY=
ACR_NAMESPACE=
