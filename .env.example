# 复制为 .env 后填写真实值。`.env` 已被 .gitignore 排除，切勿提交。
# 生成随机密钥：openssl rand -base64 48 | tr -d '/+='

# Development / Staging / Production
KUAIJI_ENVIRONMENT=Production

# 数据库（compose 内置的 postgres 服务）
KUAIJI_DB_NAME=kuaiji
KUAIJI_DB_USER=kuaiji
KUAIJI_DB_PASSWORD=
KUAIJI_JWT_KEY=

# 首次部署时置 true 以创建初始管理员与默认账套，成功后改回 false
KUAIJI_SEED_ENABLED=false
KUAIJI_ADMIN_USERNAME=admin
KUAIJI_ADMIN_PASSWORD=

# 对外访问地址与端口
KUAIJI_PUBLIC_ORIGIN=http://localhost
KUAIJI_HTTP_PORT=80

# 配好 TLS 证书后再打开（否则会强制跳转导致访问不了）
KUAIJI_HTTPS_REDIRECT=false
KUAIJI_USE_HSTS=false

KUAIJI_IMAGE_TAG=latest
