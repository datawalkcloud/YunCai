{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.20.0", 
    "generators": {
      "typescript-fetch": {
        "inputSpec": "http://localhost:5271/openapi/v1.json",
        "output": "./src/apis-gen",
        "generatorName": "typescript-fetch",
        "additionalProperties": {
          "strictNullChecks": true,
          "withSeparateModelsAndApi": true,
          "useSingleRequestParameter": true,
          "useUnionTypes": false,
          "withInterfaces": true,
          "apiMethodNameFormat": "operationId",
          "useOperationIdForMethodName": true
        }
      }
    }
  }
}