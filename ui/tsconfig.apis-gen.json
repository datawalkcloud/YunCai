{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/apis-gen-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.apis-gen.tsbuildinfo",
